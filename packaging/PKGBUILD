# Maintainer: Walter Rodrigues <walterdemacedorodrigues@gmail.com>
#
# Local-build PKGBUILD: assembles the package from the working tree this
# file lives in. No tag, no GitHub download — useful for installing your
# own branch / unreleased changes.
#
# Run from the repo:
#     cd packaging && makepkg -si

pkgname=tmux-tray
pkgver=0.2.0
pkgrel=1
pkgdesc="System tray monitor for tmux sessions (KDE/Wayland)"
arch=('any')
url="https://github.com/walterdemacedorodrigues/tmux-tray-manager"
license=('MIT')
depends=('python>=3.11' 'tmux' 'pyside6')
makedepends=('python-build' 'python-installer' 'python-hatchling' 'python-wheel')
source=()
sha256sums=()
options=('!debug')

build() {
  rm -rf "$srcdir/buildtree"
  mkdir -p "$srcdir/buildtree"
  cd "$startdir/.."
  # Copy only the files needed for the wheel build. We must NOT copy
  # 'packaging/' because $srcdir lives inside it (packaging/src/buildtree),
  # so `cp -r packaging/ ...` would recurse into the destination.
  cp -r LICENSE README.md pyproject.toml src tests "$srcdir/buildtree/"
  cd "$srcdir/buildtree"
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/buildtree"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
